# Copie para .env.local e preencha com os dados que o DevOps enviar (nunca commite o .env.local).

# API e uso normal: host com -pooler (PgBouncer do Neon)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/gamekeys?sslmode=require&channel_binding=require"
# Conexão direta: migrações, cliente gráfico e pg_dump
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/gamekeys?sslmode=require&channel_binding=require"
# Banco de testes: o pytest apaga e recria a estrutura dele
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/gamekeys_teste?sslmode=require&channel_binding=require"

# Alternativa local com Docker Compose (docker compose up -d --wait na raiz): troque as
# três linhas acima por estas
# DATABASE_URL=postgresql://gamekeys:gamekeys@localhost:5432/gamekeys
# DATABASE_URL_UNPOOLED=postgresql://gamekeys:gamekeys@localhost:5432/gamekeys
# TEST_DATABASE_URL=postgresql://gamekeys:gamekeys@localhost:5432/gamekeys_teste

# API
# desenvolvimento ou producao (em producao a documentação /docs fica desligada)
AMBIENTE=desenvolvimento
# Origens do front-end que podem chamar a API, separadas por vírgula
CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173
# Quanto a API espera o banco antes de responder 503
BANCO_TIMEOUT_SEGUNDOS=5

# Autenticação. Gere um valor longo e exclusivo para cada ambiente; nunca commite o valor real.
JWT_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-bytes"
JWT_DURACAO_MINUTOS=60
