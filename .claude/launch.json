{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000", "--reload", "--reload-dir", "backend/app"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && exec corepack pnpm dev"],
      "port": 5173
    }
  ]
}
